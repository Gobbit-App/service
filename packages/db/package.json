{
  "name": "@pb/db",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./seed/run-seed.ts",
    "./test": "./test/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:rollback": "tsx --env-file-if-exists=../../.env scripts/rollback.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pb/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.1.0"
  }
}
