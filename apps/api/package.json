{
  "name": "@pb/api",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(server|worker)$/\"",
    "dev:server": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "openapi": "tsx scripts/openapi.ts",
    "og:static": "tsx scripts/og-static.ts",
    "search:load": "tsx --env-file-if-exists=../../.env scripts/search-load.ts",
    "search:query": "tsx --env-file-if-exists=../../.env scripts/search-query.ts",
    "media:reconcile": "tsx --env-file-if-exists=../../.env scripts/media-reconcile.ts",
    "job:run": "tsx --env-file-if-exists=../../.env scripts/run-job.ts",
    "links:snapshot-backfill": "tsx --env-file-if-exists=../../.env scripts/links-snapshot-backfill.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@mozilla/readability": "^0.6.0",
    "@pb/db": "workspace:*",
    "@pb/shared": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@sindresorhus/slugify": "^3.0.1",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "lru-cache": "^11.5.3",
    "micromark": "^4.0.3",
    "openai": "^7.32.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "resend": "^6.30.0",
    "satori": "^0.35.0",
    "svix": "^2.8.0",
    "tsx": "^4.23.15",
    "undici": "^8.12.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/pg": "^8.23.1"
  }
}
