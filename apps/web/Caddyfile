# D51: the web image owns the routing for the one public origin.
#   /api/*  -> API with the prefix stripped     /s/*  -> API unchanged (share previews)
#   /p/*, /sitemap.xml, /robots.txt -> API unchanged (public pages, D177/D179)
#   / without a gobbit_session cookie -> API /welcome (landing page, D226; URL stays /)
#   /welcome, /welcome/joined -> API unchanged (landing page and its form, D228)
#   files   -> served from /srv                  else  -> index.html (SPA fallback)
# D54: response headers (connect-src allows Cloudinary: the service worker fetch()es images to cache them,
# and the editor uploads photos straight to api.cloudinary.com, D133;
# img-src allows blob: for the share screen's thumbnails, D108). API_UPSTREAM overrides the default upstream (api:3000).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://res.cloudinary.com https://api.cloudinary.com; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /s/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /p/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	@seo path /sitemap.xml /robots.txt
	handle @seo {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# D226/D227: only cookie presence is checked; a stale cookie gets the SPA, whose 401
	# handler sends the visitor to /welcome. X-Gobbit-Via only feeds landing.render (D242).
	@landing {
		path /
		not header_regexp Cookie (^|;\s*)gobbit_session=
	}
	handle @landing {
		request_header X-Gobbit-Via root
		rewrite * /welcome?{query}
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	@welcome path /welcome /welcome/joined
	handle @welcome {
		request_header -X-Gobbit-Via
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /srv

		# Hashed build output never changes; everything else (HTML, sw.js, the manifest,
		# version.json and SPA routes) must be revalidated so a deploy is picked up.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@static path /icons/* /og/* /favicon.svg
		header @static Cache-Control "public, max-age=86400"
		@revalidate not path /assets/* /icons/* /og/* /favicon.svg
		header @revalidate Cache-Control "no-cache"

		# D98: the service worker answers the share target's POST /share. Without one (not
		# installed yet, or bypassed) send the user to the paste box instead of a 405.
		@sharePost {
			method POST
			path /share
		}
		redir @sharePost /share?failed=1 303

		try_files {path} /index.html
		file_server
	}
}
