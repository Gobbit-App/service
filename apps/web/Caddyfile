# D51: the web image owns the routing for the one public origin.
#   /api/*  -> API with the prefix stripped     /s/*  -> API unchanged (share previews)
#   files   -> served from /srv                  else  -> index.html (SPA fallback)
# D54: response headers. API_UPSTREAM overrides the default upstream (api:3000).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; connect-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle /s/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /srv

		# Hashed build output never changes; everything else (HTML, sw.js, the manifest,
		# version.json and SPA routes) must be revalidated so a deploy is picked up.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@static path /icons/* /og/* /favicon.svg
		header @static Cache-Control "public, max-age=86400"
		@revalidate not path /assets/* /icons/* /og/* /favicon.svg
		header @revalidate Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
