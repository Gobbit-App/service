# PostgreSQL connection string
DATABASE_URL=postgres://pb:pb@localhost:5432/pb

# API server port
PORT=3000

# Enable development authentication (requires DEV_API_TOKEN)
DEV_AUTH_ENABLED=true

# generate: openssl rand -hex 32 (>= 32 chars required when DEV_AUTH_ENABLED=true)
DEV_API_TOKEN=

# Owner seeded by `pnpm db:seed` (required; D49 — the seed creates only this user)
SEED_OWNER_EMAIL=dev@example.test
# SEED_OWNER_NAME defaults to the email local part
SEED_OWNER_NAME=

# Development user email for authentication (must match SEED_OWNER_EMAIL)
DEV_USER=dev@example.test

# Base URL for the API (used in e2e tests)
BASE_URL=http://localhost:3000
