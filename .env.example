# PostgreSQL connection string (host-side: pnpm dev / db:* scripts, which load this file)
DATABASE_URL=postgres://gobbit:gobbit@localhost:5432/gobbit
# Password of the local Compose db (docker-compose.local.yml only; the deployed API uses DATABASE_URL
# to the shared database, D67)
POSTGRES_PASSWORD=gobbit

# API server port
PORT=3000

# Public address of the API, used to build magic-link and share URLs. `pnpm dev` serves the app
# on Vite (5173), which proxies /api and /s to the API, so links and cookies live on that origin
# (D64; deployed: https://gobbit.niranhome.win/api — D46)
API_URL=http://localhost:5173/api
# Web app origin; when unset the sign-in callback redirects to ${API_URL}/me
APP_URL=http://localhost:5173

# Session cookie (D28): host-only when COOKIE_DOMAIN is empty; Secure must be false on plain HTTP
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Comma-separated origins allowed for CORS with credentials and CSRF (D32)
CORS_ORIGINS=

# Mail (D25): console prints sign-in/invite links to the API log; resend sends real email
MAIL_PROVIDER=console
# Required with MAIL_PROVIDER=console when NODE_ENV=production (e.g. the Compose API container)
ALLOW_CONSOLE_MAIL=true
RESEND_API_KEY=
MAIL_FROM=
# Header carrying the real client IP behind a proxy (deployed: cf-connecting-ip); empty = socket address
CLIENT_IP_HEADER=

# API + worker log level (JSON lines on stdout): trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info

# Cloudinary credentials URL (D55, D60): image delivery and the OG image cache. Optional
# locally (image cards and generated share previews are then off), required in production.
# Format: cloudinary://<api key>:<api secret>@<cloud name>
CLOUDINARY_URL=

# Optional search providers (D73, ADR-044). OPENROUTER_API_KEY alone enables embeddings and Ask
# and wins over the direct keys. Without an embedding key (OpenRouter/OpenAI) search is text-only
# and the worker embeds nothing; without an Ask key (OpenRouter/Anthropic) Ask is off. Never logged.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small   # bare id; sent to OpenRouter as openai/<id>
# ASK_MODEL=                               # default anthropic/claude-haiku-5.5 (OpenRouter) / claude-haiku-5-5 (Anthropic)
#                                         # cheaper on OpenRouter for local testing: qwen/qwen3.7-flash
# WORKER_CONCURRENCY=2

# Phase 5 ingestion (D93): on whenever an Ask provider key above is set.
# EXTRACT_MODEL=                           # unset → the provider's Haiku default
# EXTRACT_ESCALATION_MODEL=                # unset → the provider's Sonnet default
# INGEST_DAILY_CAP=50                      # ingest jobs per user and channel per rolling day (combined ceiling 200)
# iCloud link of the published "Share to Gobbit" Shortcut (docs/shortcut/README.md)
# SHORTCUT_URL=
# Email-in (D104) is off unless INGEST_EMAIL_DOMAIN, RESEND_WEBHOOK_SECRET and RESEND_API_KEY
# are all set. Point the domain's MX at Resend and its inbound webhook at /api/webhooks/resend/inbound.
# INGEST_EMAIL_DOMAIN=in.example.com
# RESEND_WEBHOOK_SECRET=                   # Svix signing secret (whsec_…), never logged

# Registration (D222): `waitlist` (default) puts unknown sign-in addresses on the waitlist;
# `open` lets anyone sign up, e.g. for local experiments
# REGISTRATION_MODE=open

# Landing analytics (D232): the Umami website id (a UUID, not a secret). Unset → no tracker on
# the landing page; nothing else ever carries one. Local Umami: `pnpm compose:up -- --profile analytics`
# ANALYTICS_SITE_ID=

# Optional lifetimes (defaults: 15 min sign-in link, 7-day invite, 90-day sliding session)
# MAGIC_LINK_TTL_MINUTES=15
# INVITE_TTL_DAYS=7
# SESSION_TTL_DAYS=90

# Traefik labels on the Compose API service (deployed host only)
# PUBLIC_HOST=gobbit.niranhome.win
# TRAEFIK_ENTRYPOINT=web

# Owner seeded by `pnpm db:seed` (required; D49 — the seed creates only this user)
SEED_OWNER_EMAIL=you@example.test
# SEED_OWNER_NAME defaults to the email local part
SEED_OWNER_NAME=

# Optional (D43): when set, the seed upserts a 365-day owner bearer session with this token
# for the e2e smoke suite. generate: openssl rand -base64 32 (>= 32 chars)
SMOKE_SESSION_TOKEN=

# Base URL for the API (used in e2e tests)
BASE_URL=http://localhost:3000
