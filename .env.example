# PostgreSQL connection string (host-side: pnpm dev / db:* scripts, which load this file)
DATABASE_URL=postgres://pb:pb@localhost:5432/pb
# Password of the local Compose db (docker-compose.local.yml only; the deployed API uses DATABASE_URL
# to the shared database, D67)
POSTGRES_PASSWORD=pb

# API server port
PORT=3000

# Public address of the API, used to build magic-link and share URLs. `pnpm dev` serves the app
# on Vite (5173), which proxies /api and /s to the API, so links and cookies live on that origin
# (D64; deployed: https://gobbit.niranhome.win/api — D46)
API_URL=http://localhost:5173/api
# Web app origin; when unset the sign-in callback redirects to ${API_URL}/me
APP_URL=http://localhost:5173

# Session cookie (D28): host-only when COOKIE_DOMAIN is empty; Secure must be false on plain HTTP
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Comma-separated origins allowed for CORS with credentials and CSRF (D32)
CORS_ORIGINS=

# Mail (D25): console prints sign-in/invite links to the API log; resend sends real email
MAIL_PROVIDER=console
# Required with MAIL_PROVIDER=console when NODE_ENV=production (e.g. the Compose API container)
ALLOW_CONSOLE_MAIL=true
RESEND_API_KEY=
MAIL_FROM=
# Header carrying the real client IP behind a proxy (deployed: cf-connecting-ip); empty = socket address
CLIENT_IP_HEADER=

# Cloudinary credentials URL (D55, D60): image delivery and the OG image cache. Optional
# locally (image cards and generated share previews are then off), required in production.
# Format: cloudinary://<api key>:<api secret>@<cloud name>
CLOUDINARY_URL=

# Optional lifetimes (defaults: 15 min sign-in link, 7-day invite, 90-day sliding session)
# MAGIC_LINK_TTL_MINUTES=15
# INVITE_TTL_DAYS=7
# SESSION_TTL_DAYS=90

# Traefik labels on the Compose API service (deployed host only)
# PUBLIC_HOST=gobbit.niranhome.win
# TRAEFIK_ENTRYPOINT=web

# Owner seeded by `pnpm db:seed` (required; D49 — the seed creates only this user)
SEED_OWNER_EMAIL=you@example.test
# SEED_OWNER_NAME defaults to the email local part
SEED_OWNER_NAME=

# Optional (D43): when set, the seed upserts a 365-day owner bearer session with this token
# for the e2e smoke suite. generate: openssl rand -base64 32 (>= 32 chars)
SMOKE_SESSION_TOKEN=

# Base URL for the API (used in e2e tests)
BASE_URL=http://localhost:3000
