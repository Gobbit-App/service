# PostgreSQL connection string
DATABASE_URL=postgres://pb:pb@localhost:5432/pb

# API server port
PORT=3000

# Public address of the API, used to build magic-link URLs
# (deployed: https://gobbit.niranhome.win/api — D46)
API_URL=http://localhost:3000
# Web app origin (Phase 3); when unset the sign-in callback redirects to ${API_URL}/me
APP_URL=

# Session cookie (D28): host-only when COOKIE_DOMAIN is empty; Secure must be false on plain HTTP
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Comma-separated origins allowed for CORS with credentials and CSRF (D32)
CORS_ORIGINS=

# Mail (D25): console prints sign-in/invite links to the API log; resend sends real email
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
# Header carrying the real client IP behind a proxy (deployed: cf-connecting-ip); empty = socket address
CLIENT_IP_HEADER=

# Owner seeded by `pnpm db:seed` (required; D49 — the seed creates only this user)
SEED_OWNER_EMAIL=you@example.test
# SEED_OWNER_NAME defaults to the email local part
SEED_OWNER_NAME=

# Optional (D43): when set, the seed upserts a 365-day owner bearer session with this token
# for the e2e smoke suite. generate: openssl rand -base64 32 (>= 32 chars)
SMOKE_SESSION_TOKEN=

# Base URL for the API (used in e2e tests)
BASE_URL=http://localhost:3000
