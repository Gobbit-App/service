# PostgreSQL connection string
DATABASE_URL=postgres://pb:pb@localhost:5432/pb

# API server port
PORT=3000

# Enable development authentication (requires DEV_API_TOKEN)
DEV_AUTH_ENABLED=true

# generate: openssl rand -hex 32 (>= 32 chars required when DEV_AUTH_ENABLED=true)
DEV_API_TOKEN=

# Development user email for authentication
DEV_USER=dev@example.test

# Base URL for the API (used in e2e tests)
BASE_URL=http://localhost:3000
