{
  "name": "gobbit",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "vitest run --project unit --project web --project integration",
    "test:unit": "vitest run --project unit --project web",
    "test:int": "vitest run --project integration",
    "test:search": "vitest run --project search --silent=false",
    "test:search:update": "SEARCH_EVAL_UPDATE=1 vitest run --project search --silent=false",
    "search:load": "pnpm --filter @gobbit/api search:load",
    "search:query": "pnpm --filter @gobbit/api search:query",
    "media:reconcile": "pnpm --filter @gobbit/api media:reconcile --",
    "job:run": "pnpm --filter @gobbit/api job:run --",
    "links:snapshot-backfill": "pnpm --filter @gobbit/api links:snapshot-backfill",
    "import:notes": "tsx --env-file-if-exists=.env apps/api/scripts/import-notes.ts",
    "test:coverage": "vitest run --coverage --project unit --project web --project integration",
    "test:e2e": "pnpm --filter e2e test",
    "db:generate": "pnpm --filter @gobbit/db db:generate",
    "db:migrate": "pnpm --filter @gobbit/db db:migrate",
    "db:rollback": "pnpm --filter @gobbit/db db:rollback",
    "db:seed": "pnpm --filter @gobbit/db db:seed",
    "dev": "pnpm --parallel --filter @gobbit/api --filter @gobbit/web dev",
    "compose:up": "(docker network inspect dokploy-network >/dev/null 2>&1 || docker network create dokploy-network >/dev/null) && docker compose -f infra/docker-compose.yml -f infra/docker-compose.local.yml up -d --build",
    "compose:down": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.local.yml down",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "api:openapi": "pnpm --filter @gobbit/api openapi && pnpm --filter @gobbit/api-client generate",
    "og:static": "pnpm --filter @gobbit/api og:static",
    "dev:api": "pnpm --filter @gobbit/api dev",
    "dev:worker": "pnpm --filter @gobbit/api dev:worker",
    "dev:web": "pnpm --filter @gobbit/web dev",
    "build:web": "pnpm --filter @gobbit/web build",
    "budget": "pnpm --filter @gobbit/web budget"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "1.9.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
